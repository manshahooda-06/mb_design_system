{
  "name": "mozaic-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/mozaic/src",
  "projectType": "library",
  "tags": ["type:library"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "cache": true,
      "options": {
        "command": "pnpm build",
        "cwd": "libs/mozaic"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "pnpm test",
        "cwd": "libs/mozaic"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "pnpm lint",
        "cwd": "libs/mozaic"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "pnpm typecheck",
        "cwd": "libs/mozaic"
      }
    },
    "storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm storybook",
        "cwd": "libs/mozaic"
      }
    },
    "build-storybook": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/storybook-static"],
      "cache": true,
      "options": {
        "command": "pnpm build:storybook",
        "cwd": "libs/mozaic"
      }
    }
  }
}

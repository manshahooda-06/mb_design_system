{
  "name": "@medibuddy/mozaic-ui",
  "version": "0.0.0",
  "description": "Mozaic — MediBuddy's enterprise React design system.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./embed.css": "./dist/embed.css",
    "./package.json": "./package.json"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "generate:color-tokens": "python3 scripts/generate-color-tokens.py && prettier --write src/foundations/colors/colors.css src/tokens/colors/index.ts",
    "generate:typography-tokens": "python3 scripts/generate-typography-tokens.py && prettier --write src/foundations/typography/typography.css src/tokens/typography/index.ts",
    "generate:spacing-tokens": "python3 scripts/generate-spacing-tokens.py && prettier --write src/foundations/spacing/spacing.css src/tokens/spacing/index.ts",
    "generate:radius-tokens": "python3 scripts/generate-radius-tokens.py && prettier --write src/foundations/radius/radius.css src/tokens/radius/index.ts",
    "generate:elevation-tokens": "python3 scripts/generate-elevation-tokens.py && prettier --write src/foundations/elevation/elevation.css src/tokens/elevation/index.ts",
    "generate:container-tokens": "python3 scripts/generate-container-tokens.py && prettier --write src/semantic/container/container.css src/tokens/semantic/container/index.ts",
    "generate:semantic-spacing-tokens": "python3 scripts/generate-semantic-spacing-tokens.py && prettier --write src/semantic/spacing/spacing.css src/tokens/semantic/spacing/index.ts",
    "generate:semantic-color-tokens": "python3 scripts/generate-semantic-color-tokens.py && prettier --write src/semantic/colors/colors.css src/tokens/semantic/colors/index.ts diagnostics/semantic-colors.json",
    "generate:component": "python3 scripts/generate-component.py",
    "build": "tsc -b && vite build",
    "build:storybook": "storybook build",
    "storybook": "storybook dev -p 6006",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "verify:tokens": "vitest run --config vitest.verify.config.ts"
  },
  "peerDependencies": {
    "framer-motion": "^11.3.30 || ^12.0.0 || ^13.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@fontsource-variable/lexend-deca": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-storybook": "^10.5.5",
    "framer-motion": "^11.13.5",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.0",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "storybook": "^10.5.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "unplugin-dts": "^1.0.3",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
